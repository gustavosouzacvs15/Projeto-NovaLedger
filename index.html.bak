  <!-- OVERLAY: TESTE EXPIRADO -->
  <div id="trialExpiredOverlay"
    class="fixed inset-0 bg-ink/90 backdrop-blur-md flex items-center justify-center z-[100] hidden p-4 overflow-y-auto">
    <div
      class="glass-card rounded-3xl p-6 md:p-8 w-full max-w-4xl shadow-glow border border-cyan-400/30 text-slate-100 flex flex-col gap-6">
      <div class="text-center space-y-2">
        <span
          class="px-3 py-1 bg-rose-500/10 border border-rose-500/30 text-rose-300 rounded-full text-xs font-semibold tracking-wider uppercase">PerÃ­odo
          de Teste Expirado</span>
        <h2 class="text-3xl font-extrabold text-white">Seu perÃ­odo de teste de 3 dias terminou!</h2>
        <p class="text-slate-300 text-sm max-w-lg mx-auto">Para continuar a utilizar o painel financeiro, gerenciar suas
          transaÃ§Ãµes e metas, escolha um de nossos planos premium abaixo.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 items-start mt-2">
        <!-- Coluna 1: Planos -->
        <div class="space-y-4">
          <h4 class="text-sm font-semibold uppercase tracking-wider text-cyan-300">1. Selecione o Plano</h4>

          <div
            class="plan-card active cursor-pointer border-2 border-cyan-400 bg-panel/80 p-4 rounded-2xl flex flex-col gap-2 hover:border-cyan-400 transition"
